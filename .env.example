# Example environment variables for local development (do NOT commit secrets)
# For Vite, environment variables that should be exposed to the client must be prefixed with VITE_

# Public API endpoint returning JSON like: [{ id, label, price, change, currency }, ...]
VITE_COMMODITY_API_URL=https://api.example.com/commodities

# Optional API key (will be sent as Bearer token in Authorization header)
VITE_COMMODITY_API_KEY=your_api_key_here

# Server-side (do NOT prefix with VITE_) broker verification key for serverless function
# Example: BROKER_API_KEY=super-secret-key
BROKER_API_KEY=

# For local development copy this file to .env.local and edit values.

# CRM & webhook configuration (server-side)
# CRM webhook that accepts POST JSON: { type: 'rfq_submission', payload: {...} }
CRM_WEBHOOK_URL=

# Optional webhook to forward a short WhatsApp message (server-side)
WHATSAPP_WEBHOOK_URL=

# Optional secret to validate submissions to /api/submit-rfq
SUBMISSION_SECRET=
